APP_NAME=RumahAsa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rumahasa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=rumahasa_

# RumahAsa custom config
# HMAC key untuk hashing NIK & No KK (detect duplicate tanpa reveal nilai asli)
NIK_HMAC_KEY=change-this-to-32-char-random-string
# Disk tempat foto survei disimpan (di luar folder public/)
FOTO_DISK=private
# Max ukuran foto per file (bytes, default 5MB = 5242880)
FOTO_MAX_SIZE=5242880
# Max jumlah foto per komponen
FOTO_MAX_PER_KOMPONEN=10
# Login throttle: max percobaan gagal sebelum lock
LOGIN_MAX_ATTEMPTS=5
# Login lock duration dalam menit
LOGIN_LOCK_MINUTES=15
